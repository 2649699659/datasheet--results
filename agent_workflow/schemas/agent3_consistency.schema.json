{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent3 Consistency Report",
  "description": "Agent 3 output schema for cross-parameter consistency checks",
  "type": "object",
  "required": ["document_id", "file_name", "overall_status", "consistency_checks", "summary"],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "overall_status": {
      "type": "string",
      "enum": ["consistent", "inconsistent", "review_needed"]
    },
    "consistency_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_name", "severity", "status", "fields_involved", "verdict"],
        "properties": {
          "rule_id": {
            "type": "string",
            "description": "Unique rule identifier"
          },
          "rule_name": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "skipped", "warning"]
          },
          "fields_involved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "details": {
            "type": "object",
            "description": "Rule-specific computed values"
          },
          "verdict": {
            "type": "string"
          },
          "suggested_action": {
            "type": "string",
            "enum": ["none", "review", "warning", "block"]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_checks", "passed", "failed", "skipped", "warnings"],
      "properties": {
        "total_checks": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
