{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Parameter Review Schema",
  "description": "Schema for AI parameter review output from AST Datasheet Extraction Workflow v1",
  "type": "object",
  "required": ["document_id", "file_name", "overall_verdict", "field_reviews", "summary"],
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Unique document identifier from the PDF extraction"
    },
    "file_name": {
      "type": "string",
      "description": "Original PDF file name"
    },
    "overall_verdict": {
      "type": "string",
      "enum": ["pass", "needs_repair", "unsafe"],
      "description": "Overall verdict for the entire document"
    },
    "field_reviews": {
      "type": "array",
      "description": "Per-field review results",
      "items": {
        "$ref": "#/definitions/field_review"
      }
    },
    "summary": {
      "$ref": "#/definitions/summary"
    }
  },
  "definitions": {
    "field_review": {
      "type": "object",
      "required": [
        "field_id",
        "current_selection_status",
        "verdict",
        "severity",
        "reason",
        "evidence",
        "suggested_action"
      ],
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "type": "string",
          "description": "Field identifier from target_fields.yaml"
        },
        "current_selection_status": {
          "type": "string",
          "enum": ["final_candidate", "review_needed", "blocked", "missing"],
          "description": "Current selection status in the pipeline"
        },
        "verdict": {
          "type": "string",
          "enum": ["correct", "wrong_candidate", "unit_error", "condition_error", "missing", "uncertain"],
          "description": "AI review verdict for this field"
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Severity of the issue found"
        },
        "reason": {
          "type": "string",
          "description": "Brief explanation for the verdict"
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        },
        "suggested_action": {
          "type": "string",
          "enum": ["keep", "replace_selected_candidate", "downgrade_to_review", "block_candidate", "mark_missing", "add_warning"],
          "description": "Recommended action for this field"
        },
        "suggested_source_hint": {
          "type": "string",
          "description": "Hint for finding a better source (optional)"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes (optional)"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["source_page", "source_text"],
      "additionalProperties": false,
      "properties": {
        "source_page": {
          "type": "integer",
          "description": "Page number in the PDF (1-indexed)"
        },
        "source_text": {
          "type": "string",
          "description": "Original text from the PDF (max 600 chars)"
        },
        "table_index": {
          "type": "integer",
          "description": "Table index on the page (optional)"
        },
        "row_index": {
          "type": "integer",
          "description": "Row index in the table (optional)"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["correct_count", "needs_repair_count", "critical_error_count"],
      "additionalProperties": false,
      "properties": {
        "correct_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of fields with verdict=correct"
        },
        "needs_repair_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of fields that need repair"
        },
        "critical_error_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of critical errors found"
        }
      }
    }
  }
}
