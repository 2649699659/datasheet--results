{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent2 Final Params",
  "description": "Agent 2 output schema for validated datasheet parameters",
  "type": "object",
  "required": ["document_id", "file_name", "overall_status", "final_params", "summary"],
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Document identifier hash"
    },
    "file_name": {
      "type": "string",
      "description": "Source PDF file name"
    },
    "overall_status": {
      "type": "string",
      "enum": ["pass", "needs_review", "unsafe"],
      "description": "Overall document assessment"
    },
    "final_params": {
      "type": "array",
      "description": "Array of validated parameter results",
      "items": {
        "$ref": "#/definitions/ParamResult"
      }
    },
    "summary": {
      "$ref": "#/definitions/Summary"
    }
  },
  "definitions": {
    "ParamResult": {
      "type": "object",
      "required": ["field_id", "status", "confidence", "reason", "warnings"],
      "properties": {
        "field_id": {
          "type": "string",
          "description": "Target field identifier"
        },
        "status": {
          "type": "string",
          "enum": ["final", "review_needed", "missing", "blocked"],
          "description": "Validation status"
        },
        "value": {
          "type": ["number", "null"],
          "description": "Single value if no range"
        },
        "min": {
          "type": ["number", "null"],
          "description": "Minimum value for ranges"
        },
        "typ": {
          "type": ["number", "null"],
          "description": "Typical value"
        },
        "max": {
          "type": ["number", "null"],
          "description": "Maximum value for ranges"
        },
        "unit": {
          "type": ["string", "null"],
          "description": "Parameter unit"
        },
        "condition": {
          "type": ["string", "null"],
          "description": "Test condition string"
        },
        "source_page": {
          "type": ["integer", "null"],
          "description": "PDF page number (1-indexed)"
        },
        "table_index": {
          "type": ["integer", "null"],
          "description": "Table index on page"
        },
        "row_index": {
          "type": ["integer", "null"],
          "description": "Row index in table"
        },
        "source_text": {
          "type": ["string", "null"],
          "description": "Original source text from datasheet"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confidence score 0.0 to 1.0"
        },
        "reason": {
          "type": "string",
          "description": "Explanation for the decision"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of warnings if any"
        }
      }
    },
    "Summary": {
      "type": "object",
      "required": ["final_count", "review_needed_count", "missing_count", "blocked_count"],
      "properties": {
        "final_count": {
          "type": "integer",
          "minimum": 0
        },
        "review_needed_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
